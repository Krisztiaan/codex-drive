{
  "description": "List the active session's codex-drive workers and switch the monitor when the session changes.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec node \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-workers.mjs\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "exec node \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-workers.mjs\" session-end"
          }
        ]
      }
    ]
  }
}
