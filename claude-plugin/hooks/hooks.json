{
  "description": "List the active session's codex-drive workers, switch the monitor when the session changes, and guard against blind polling or shared git stash mutations.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec node \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-workers.mjs\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "exec node \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-workers.mjs\" session-end"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v codex-drive >/dev/null 2>&1 && exec codex-drive hook all --agent claude || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
